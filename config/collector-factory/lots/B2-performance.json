{
 "_doc": "CHG-ESTACK-COLLECTOR-FACTORY-B2 \u2014 lot B2: performance (waits, DB time, I/O, memory, parse, top SQL by sql_id, blocking, temp, parallel, redo) for /diagnose and /healthcheck performance. No Diagnostics Pack views. Same rules as lots/B1-oracle-core.json.",
 "lot_id": "B2",
 "fixture_target": "fixture-primary-19c",
 "collectors": [
  {
   "collector_id": "Q-PERF-WAIT-SYSTEM-001",
   "domain": "performance",
   "title": "Top 25 non-idle wait events since startup: waits, timeouts, time and average wait (no license)",
   "row_limit": 25,
   "fields": [
    "event",
    "wait_class",
    "total_waits",
    "total_timeouts",
    "time_waited_sec",
    "avg_wait_ms"
   ]
  },
  {
   "collector_id": "Q-PERF-WAIT-CLASS-001",
   "domain": "performance",
   "title": "Non-idle wait time by wait class since startup (no license)",
   "row_limit": 20,
   "fields": [
    "wait_class",
    "total_waits",
    "time_waited_sec"
   ]
  },
  {
   "collector_id": "Q-PERF-DBTIME-CURRENT-001",
   "domain": "performance",
   "title": "DB time and DB CPU in seconds since startup, and uptime (no license)",
   "row_limit": 1,
   "fields": [
    "db_time_sec_since_startup",
    "db_cpu_sec_since_startup",
    "uptime_sec"
   ]
  },
  {
   "collector_id": "Q-PERF-IO-001",
   "domain": "performance",
   "title": "Dominant I/O and commit wait events since startup",

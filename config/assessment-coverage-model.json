 "domain_states": [
  "COMPLETE",
  "COMPLETE_WITHIN_POLICY",
  "PARTIAL",
  "NOT_ASSESSED",
  "NOT_APPLICABLE",
  "INSUFFICIENT_EVIDENCE"
 ],
 "exclusion_categories": {
  "DATA_CLASSIFICATION": {
   "policy": "sanitizers/data-classification-policy.md",
   "meaning": "El dato existe en la base pero la política de clasificación impide que salga"
  },
  "FORBIDDEN_OPERATION": {
   "policy": "policies/forbidden-operations.md",
   "meaning": "Obtenerlo exige ejecutar una operación prohibida"
  },
  "LICENSE_NOT_ENTITLED": {
   "policy": "policies/licensing-awareness-policy.md",
   "meaning": "Requiere un pack que el humano declaró no licenciado (license_status NOT_LICENSED)"
  },
  "LICENSE_ENTITLEMENT_NOT_ASSERTED": {
   "policy": "policies/licensing-awareness-policy.md",
   "meaning": "Es un dato del contrato, que el e-stack nunca afirma"
  }
 },

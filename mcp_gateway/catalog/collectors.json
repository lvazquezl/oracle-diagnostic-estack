      "output_fields": {
        "con_id": {"type": "integer", "min": 0, "max": 4098, "policy": "KEEP"},
        "tablespace_name": {"type": "identifier", "policy": "MASK", "alias_prefix": "ts"},
        "allocated_bytes": {"type": "integer", "min": 0, "max": 100000000000000, "policy": "KEEP"},
        "bytes_used": {"type": "integer", "min": 0, "max": 100000000000000, "policy": "KEEP"},
        "bytes_free": {"type": "integer", "min": 0, "max": 100000000000000, "policy": "KEEP"}

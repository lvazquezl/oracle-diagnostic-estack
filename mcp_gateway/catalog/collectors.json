        "used_percent": {"type": "number", "min": 0, "max": 100, "policy": "KEEP"},
        "used_space": {"type": "integer", "min": 0, "max": 10000000000000, "policy": "KEEP"},
        "tablespace_size": {"type": "integer", "min": 0, "max": 10000000000000, "policy": "KEEP"},
        "status": {"type": "enum", "values": ["ONLINE", "OFFLINE", "READ ONLY"], "policy": "KEEP"},
        "contents": {"type": "enum", "values": ["PERMANENT", "TEMPORARY", "UNDO", "LOST WRITE PROTECTION"], "policy": "KEEP"}

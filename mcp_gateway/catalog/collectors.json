      "reference": "docs/OS_READONLY_COLLECTOR_MODEL.md#get_oracle_process_summary",
      "row_limit": 5,
      "params": {},
      "output_fields": {
        "observed_at_utc": {"type": "timestamp_utc", "policy": "KEEP"},
        "fork_failures_observed": {"type": "boolean", "policy": "KEEP"},
        "oracle_process_count": {"type": "integer", "min": 0, "max": 1000000, "policy": "KEEP"}
      },
      "rca": {"domain": "os", "event_type": "SYMPTOM_OBSERVED", "source_id": "os-fork-audit-collector", "timestamp_field": "observed_at_utc", "signature_field": null,
              "attributes": {"fork_failures_observed": "fork_failures_observed"}},
      "adapters": {"fixture": "VERIFIED_FIXTURE", "os_readonly": "CONTRACT_ONLY"}
    },
    {
      "collector_id": "Q-CDB-TABLESPACES-001",

    {
      "collector_id": "Q-RMAN-FRA-USAGE-001",
      "kind": "sql_query",
      "domain": "rman",
      "title": "Fast Recovery Area usage by file type vs limit (destination path not exposed)",
      "row_limit": 20,
      "params": {},
      "output_fields": {
        "file_type": {"type": "enum", "values": ["CONTROL FILE", "REDO LOG", "ARCHIVED LOG", "BACKUP PIECE", "IMAGE COPY", "FLASHBACK LOG", "FOREIGN ARCHIVED LOG", "AUXILIARY DATAFILE COPY"], "policy": "KEEP"},
        "percent_space_used": {"type": "number", "min": 0, "max": 100, "policy": "KEEP"},
        "percent_space_reclaimable": {"type": "number", "min": 0, "max": 100, "policy": "KEEP"},
        "number_of_files": {"type": "integer", "min": 0, "max": 100000000, "policy": "KEEP"},
        "space_limit": {"type": "integer", "min": 0, "max": 1000000000000000, "policy": "KEEP"},
        "space_used": {"type": "integer", "min": 0, "max": 1000000000000000, "policy": "KEEP"},
        "space_reclaimable": {"type": "integer", "min": 0, "max": 1000000000000000, "policy": "KEEP"},
